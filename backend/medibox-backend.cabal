cabal-version:      2.4
name:               medibox-backend
version:            0.1.0.0
synopsis:           Bidirectional sync between a Behringer BCR2000 and a browser UI
license:            BSD-3-Clause
author:             paolo veronelli
maintainer:         paolo.veronelli@gmail.com
category:           Sound
build-type:         Simple

common warnings
    ghc-options:      -Wall

common extensions
    default-language: GHC2021
    default-extensions:
        LambdaCase
        OverloadedStrings
        RecordWildCards
        ViewPatterns

library
    import:           warnings, extensions
    hs-source-dirs:   src
    exposed-modules:
        Medibox.Midi
        Medibox.Store
        Medibox.Protocol
        Medibox.Sync
        Medibox.Server

    build-depends:
        base >=4.18 && <5,
        aeson,
        alsa-core,
        alsa-seq,
        bytestring,
        containers,
        sqlite-simple,
        stm,
        text,
        wai,
        wai-websockets,
        warp,
        websockets

executable medibox-backend
    import:           warnings, extensions
    main-is:          Main.hs
    hs-source-dirs:   app
    ghc-options:      -threaded -O0
    build-depends:
        base,
        medibox-backend

test-suite medibox-backend-test
    import:           warnings, extensions
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    other-modules:
        Medibox.StoreSpec
        Medibox.ProtocolSpec

    build-tool-depends: hspec-discover:hspec-discover
    build-depends:
        base,
        medibox-backend,
        aeson,
        hspec,
        QuickCheck,
        sqlite-simple,
        text
